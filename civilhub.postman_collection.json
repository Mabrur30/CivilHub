              "raw": "{\n  \"title\": \"Northline By-Pass\",\n  \"description\": \"Upgrade the bypass corridor with drainage improvements and road widening for heavy freight access.\",\n  \"category\": \"Infrastructure\",\n  \"budgetMin\": 180000,\n  \"budgetMax\": 260000,\n  \"location\": \"Northline District, Brisbane\",\n  \"targetStartDate\": \"2026-09-15\",\n  \"targetCompletionDate\": \"2026-12-20\"\n}"
