PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=
JWT_SECRET=

# Public URL of this API; SSLCommerz sends customers back here after checkout.
SERVER_URL=http://localhost:5000

# SSLCommerz (https://developer.sslcommerz.com). Sandbox keys come from the sandbox signup.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# Share of each payment CivilHub keeps (0.1 = 10%). Deposits are never commissioned.
PLATFORM_COMMISSION_RATE=0.1
