PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=
# At least 32 random characters; the server won't start in production otherwise.
JWT_SECRET=
# Behind a reverse proxy (nginx, Render, Railway...), the number of proxies in
# front of the API, usually 1. Leave at 0 when clients connect directly.
TRUST_PROXY=0

# The separate admin dashboard (the admin/ app). Its sessions are signed with
# their own secret: at least 32 random characters, never the same as
# JWT_SECRET. Admin accounts are made with `npm run admin:create`.
ADMIN_URL=http://localhost:5174
ADMIN_JWT_SECRET=

# Public URL of this API; SSLCommerz sends customers back here after checkout.
SERVER_URL=http://localhost:5000

# SSLCommerz (https://developer.sslcommerz.com). Sandbox keys come from the sandbox signup.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Required in production: "false" for live payments. The server won't start if it's unset.
SSLCOMMERZ_IS_SANDBOX=true

# Share of each payment CivilHub keeps (0.1 = 10%). Deposits are never commissioned.
PLATFORM_COMMISSION_RATE=0.1

# Cloudinary stores uploaded photos and files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenStreetMap Nominatim for the project site search. Its policy needs a
# contact address in the User-Agent; point NOMINATIM_URL at a self-hosted
# instance if traffic outgrows the public one (1 request a second).
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=
